{
  "name": "pilotignore",
  "version": "0.2.0",
  "description": "Keep GitHub Copilot agents out of the files you list in .pilotignore. Works like .gitignore, for Copilot tool calls.",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "pilotignore": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkerttula/pilotignore.git"
  },
  "bugs": "https://github.com/vkerttula/pilotignore/issues",
  "homepage": "https://github.com/vkerttula/pilotignore#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node tests/smoke.mjs",
    "sandbox": "node tests/sandbox/create.mjs"
  },
  "keywords": [
    "copilot",
    "github",
    "hook",
    "ignore",
    "security",
    "copilotignore",
    "firewall",
    "agent",
    "pre-tool-use",
    "copilot-hooks"
  ],
  "files": [
    "bin",
    "src",
    "CHANGELOG.md"
  ],
  "author": "Valtteri Kerttula",
